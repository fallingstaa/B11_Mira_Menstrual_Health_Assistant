PORT=5000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db-name>?appName=<app-name>

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Same value as mobile-app/.env's EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET — not a secret,
# just an identifier. Only used for POST /api/profile/avatar (Firebase Storage uploads).
FIREBASE_STORAGE_BUCKET=

GEMINI_API_KEY=

# Comma-separated list of allowed browser origins for CORS (e.g.
# https://app.example.com,https://admin.example.com). Only read/enforced when
# NODE_ENV=production — see config/cors.js. Irrelevant to the mobile app itself
# (native fetch never sends an Origin header), this only matters for browser clients.
ALLOWED_ORIGINS=

# --- Local dev/testing only (used by scripts/get-test-token.js to mint a Firebase ID
# token for testing protected endpoints in Swagger, without touching the mobile app) ---
TEST_FIREBASE_WEB_API_KEY=
TEST_USER_EMAIL=dev-tester@mira.test
TEST_USER_PASSWORD=DevTester123!
