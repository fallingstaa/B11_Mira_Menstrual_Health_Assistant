# Firebase client (web app) config — from Firebase Console → Project Settings →
# General → Your apps → Web app. NOT a secret (see src/config/firebase.ts comment) —
# it's fine for this to end up in the bundled app, unlike the backend's
# FIREBASE_PRIVATE_KEY, which must never appear here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Where the Express backend is reachable from this device.
# - Web / iOS simulator: http://localhost:5000
# - Physical device via Expo Go: http://<your-computer's-LAN-IP>:5000 (localhost on a
#   phone means the phone itself, not your dev machine)
EXPO_PUBLIC_API_URL=http://localhost:5000
